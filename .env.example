# Example environment variables for development
# Copy to `.env` and update values as needed

# For Prisma (Optional - database features will be mocked if missing)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?sslmode=require"
# Uncomment the next line if you use Prisma <5.10
# DATABASE_URL_UNPOOLED="postgresql://username:password@localhost:5432/dbname?sslmode=require"

# Admin password for checklist
ADMIN_PASSWORD="your_admin_password_here"
